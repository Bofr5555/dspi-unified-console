# uConsole for DSPi: lets any account open a DSPi over USB without root. This
# one file is the rule of every part of uConsole for DSPi: `uconsole
# --install-udev`, the desktop app's device-access dialog, the .deb, .rpm and
# AUR packages (/usr/lib/udev/rules.d/) and the archive's install.sh
# (/etc/udev/rules.d/), always named 70-dspi.rules.
#
# Install by hand:  sudo cp 70-dspi.rules /etc/udev/rules.d/
#                   sudo udevadm control --reload-rules
#                   then unplug and replug the device.
#
# MODE="0666" covers headless setups (a Raspberry Pi reached over SSH, a hub
# service), where there is no seat for logind's uaccess tag to apply to; the
# tag stays for desktops.

# A DSPi: vendor 2e8b; firmware before that used the Raspberry Pi vendor 2e8a
# with product feaa.
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8b", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="feaa", TAG+="uaccess", MODE="0666"

# The RP2350 bootloader (2e8a:0003) a DSPi re-enumerates as during a firmware
# update. Without this, an update appears to hang at exactly the wrong moment.
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0003", TAG+="uaccess", MODE="0666"
