       "gain_db": -6
      },
      {
       "op": "set_gain",
       "output": 1,
       "gain_db": 2
      },
      {
       "op": "set_gain",
       "output": 2,
       "gain_db": -3
      },
      {
       "op": "set_gain",
       "output": 3,
       "gain_db": 2
      }
     ]
    },
    "ok"
   ],
   [
    "dspi_preset_save",
    {
     "device": "demo:2",
     "slot": 3,
     "name": "Late night"
    },
    "ok",
    "one question names it (owner 2026-11-23, INTI)"
   ],
   [
    "dspi_snapshot_capture",
    {
     "device": "demo:2",
     "name": "Late night"
    },
    "ok"
   ],
   [
    "dspi_preset_load",
    {
     "device": "demo:2",
     "slot": 9
    },
    "error",
    "the user's Test lowers the tweeter's high-pass: refused and put back",
    "still 9"
   ],
   [
    "dspi_preset_load",
    {
     "device": "demo:2",
     "slot": 2
    },
    "ok"
   ]
  ],
  "compare": [
   [
    "dspi_ab_start",
