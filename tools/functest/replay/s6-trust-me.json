{
 "story": "s6-trust-me.toml",
 "confirm": "ask_risky",
 "steps": {
  "rewired": [
   [
    "dspi_get_overview",
    {
     "device": "demo:2"
    },
    "ok",
    "roles from an unconfirmed setup",
    "",
    "\"roles_from\":\\s*\"speaker_setup_unconfirmed\""
   ],
   [
    "dspi_measure_start",
    {
     "device": "demo:2",
     "outputs": [
      5
     ],
     "sweep_ms": 2000,
     "passes": 3
    },
    "error",
    "no test signal on an unconfirmed setup: the text offers the roles from the user's words",
    "",
    "dspi_set_speaker_roles"
   ],
   [
    "dspi_measure_start",
    {
     "device": "demo:2",
     "outputs": [
      {
       "output": 5,
       "role": "high"
      }
     ]
    },
    "error",
    "no measuring tool takes a role"
   ],
   [
    "dspi_set_speaker_roles",
    {
     "device": "demo:2",
     "user_words": "I rewired the centre: the woofer is still on output 1, output 4 is now the midrange and output 5 the tweeter; the sub moved to output 6.",
     "rows": [
      {
       "output": 1,
       "role": "woofer",
       "speaker": "Centre"
      },
      {
       "output": 4,
       "role": "midrange",
       "speaker": "Centre"
      },
      {
       "output": 5,
       "role": "tweeter",
       "speaker": "Centre"
      },
      {
       "output": 6,
       "role": "sub",
       "speaker": "Sub"
      }
     ]
    },
    "ok",
    "the roles from the user's words: one question, the whole table",
    "",
    "speaker_setup_stated"
   ],
   [
    "dspi_get_overview",
    {
     "device": "demo:2"
    },
    "ok",
    "set by AI from the user's words",
    "",
    "speaker_setup_stated"
   ],
   [
    "dspi_set_crossover",
    {
     "device": "demo:2",
     "output": 5,
     "high_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 2000
     }
    },
    "ok",
    "the tweeter's high-pass first"
   ],
   [
    "dspi_set_crossover",
    {
     "device": "demo:2",
     "output": 4,
     "high_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 400
     }
    },
    "ok",
    "the midrange's high-pass (the preflight's rule); its low-pass after the measurement, or it hides the top end from the check"
   ],
   [
    "dspi_measure_start",
    {
     "device": "demo:2",
     "outputs": [
      1,
      4,
      5,
      6
     ],
     "one_run": true,
     "placement": "listening_position"
    },
    "ok",
    "the stated woofer, midrange and sub are checked first, then the one run",
    "",
    "First a check that Out 1 \\(stated woofer\\), Out 4 \\(stated midrange\\), Out 6 \\(stated subwoofer\\)"
   ],
   [
    "wait",
    {
     "device": "demo:2"
    }
   ],
   [
    "dspi_measure_status",
    {
     "device": "demo:2"
    },
    "ok",
    "what the check found comes first",
    "",
    "Out 1 \\(stated woofer\\)"
   ],
   [
    "dspi_set_crossover",
    {
     "device": "demo:2",
     "output": 4,
     "low_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 2000
     },
     "high_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 400
     }
    },
    "ok"
   ],
   [
    "dspi_set_crossover",
    {
     "device": "demo:2",
     "output": 1,
     "low_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 400
     }
    },
    "ok"
   ]
  ],
  "midrange": [
   [
    "dspi_set_speaker_roles",
    {
     "device": "demo:2",
     "user_words": "Actually output 5 is a midrange, not a tweeter.",
     "rows": [
      {
       "output": 1,
       "role": "woofer",
       "speaker": "Centre"
      },
      {
       "output": 4,
       "role": "midrange",
       "speaker": "Centre"
      },
      {
       "output": 5,
       "role": "midrange",
       "speaker": "Centre"
      },
      {
       "output": 6,
       "role": "sub",
       "speaker": "Sub"
      }
     ]
    },
    "ok",
    "the user's new words: asked again"
   ],
   [
    "dspi_measure_rolloff_start",
    {
     "device": "demo:2",
     "output": 5
    },
    "ok",
    "a check before anything plays below 1 kHz on it",
    "",
    "First a check that Out 5 \\(stated midrange\\)"
   ],
   [
    "wait",
    {
     "device": "demo:2"
    }
   ],
   [
    "dspi_measure_status",
    {
     "device": "demo:2"
    },
    "ok",
    "the wrong claim caught: the agent is told",
    "",
    "Out 5 looks like a tweeter"
   ],
   [
    "dspi_get_overview",
    {
     "device": "demo:2"
    },
    "ok",
    "the safety rules take it for a tweeter",
    "",
    "\"role_check\":\\s*\"looks_like_tweeter\""
   ],
   [
    "dspi_set_crossover",
    {
     "device": "demo:2",
     "output": 5,
     "high_pass": {
      "family": "linkwitz_riley",
      "order": 4,
      "freq_hz": 600
     }
    },
    "error",
    "a tweeter to the safety rules: not below 1 kHz",
    "",
    "tweeter"
   ]
  ]
 }
}