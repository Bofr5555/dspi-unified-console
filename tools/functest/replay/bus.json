  ["bus_expect", {"device": "Fronts", "output": 1, "rms_dbfs": [-35.8, -34.8]}, "ok", "UAC: the OS at 50 % sets the user volume to -18.1 dB, which plays as -19"],
  ["dspi_set_mute", {"device": "demo:1", "output": 0, "muted": true}, "ok"],
