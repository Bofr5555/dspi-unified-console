  ["bus_expect", {"device": "Fronts", "output": 1, "rms_dbfs": [-36.8, -35.8], "spl_db": [40, 110]}, "ok", "the woofer at -16.3 - 20 dB"],
  ["bus_expect", {"device": "Fronts", "output": 2, "silent": true}, "ok", "nothing is routed to the tweeter"],
  ["dspi_get_meters", {"device": "demo:1"}, "ok"],
