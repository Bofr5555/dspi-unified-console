# SPDX-License-Identifier: GPL-3.0-or-later
# ci/run.sh's `cross` profile (tag localhost/dspi-cross:<n>; see images.conf): the
# Android build image (apps/android/container/Containerfile: NDK, cargo-ndk, Rust)
# plus MSVC through cargo-xwin, MinGW, and wasm32.
#
# Replaces localhost/dspi-termport-xwin:1, which came from two files in scratch
# areas and an unpinned cargo-xwin. This is those two files as one, with cargo-xwin
# at the version :1 had.
#
# Sources: Ubuntu's archive (apt checks signatures; the base pins the release, not
# the package versions), static.rust-lang.org, crates.io (--locked; cargo checks
# each crate's checksum). The MSVC CRT and SDK are not in the image: xwin fetches
# them from Microsoft at build time, into the mounted XWIN_CACHE_DIR, checked
# against the SHA-256 in Microsoft's manifest. The owner accepted that licence.
ARG ANDROID_IMAGE
FROM $ANDROID_IMAGE
USER root
ARG CARGO_XWIN_VERSION=0.23.1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 \
      gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
      libasound2-dev libudev-dev \
      clang lld llvm \
 && rm -rf /var/lib/apt/lists/*
RUN CARGO_HOME=/opt/cargo /opt/cargo/bin/rustup target add \
      x86_64-pc-windows-gnu x86_64-pc-windows-msvc aarch64-unknown-linux-gnu wasm32-unknown-unknown
RUN CARGO_HOME=/var/tmp/xwin-home CARGO_TARGET_DIR=/var/tmp/xwin-target \
    /opt/cargo/bin/cargo install --locked --version "$CARGO_XWIN_VERSION" --root /opt/cargo cargo-xwin \
 && rm -rf /var/tmp/xwin-home /var/tmp/xwin-target
