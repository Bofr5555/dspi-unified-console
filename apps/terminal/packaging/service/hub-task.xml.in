<?xml version="1.0"?>
<!--
  DSPi Link hub as a Windows scheduled task: shares this PC's DSPi devices on the
  network from logon. A placeholder to adapt (WP TM11): see README.md. A template:
  render.sh fills in the command name (WP CLEAN1).

  Import (PowerShell, as the user who will run it):
    Register-ScheduledTask -TaskName "@CMD@ hub" -Xml (Get-Content -Raw .\@CMD@-hub-task.xml)
  Remove:
    Unregister-ScheduledTask -TaskName "@CMD@ hub"
  The declaration names no encoding on purpose: -Xml hands Task Scheduler a UTF-16
  string, and a declared UTF-8 fails with "unable to switch the encoding" (WP CG31).
  `schtasks /create /xml` needs the file saved as UTF-16 first.

  Edit the Command if @CMD@.exe is installed elsewhere. PIN pairing is the default:
  do not add the open option here. To pair a client, end the task, run `@CMD@ hub`
  in a terminal, type `pair`, and start the task again when the client has paired.
  The console window this opens is the hub; closing it stops sharing. For no
  window, run it as a service through a wrapper (README.md).
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>DSPi Link hub: shares this PC's DSPi devices on the network (@CMD@ hub).</Description>
    <URI>\@CMD@ hub</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- No time limit: it runs until logoff or until it is ended. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- At most 3 tries: a refused start (exit 1: another hub holds the store, or a
         change of access mode; exit 4: the port in use) does not mend itself. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>"C:\Program Files\@CMD@\@CMD@.exe"</Command>
      <Arguments>hub</Arguments>
    </Exec>
  </Actions>
</Task>
