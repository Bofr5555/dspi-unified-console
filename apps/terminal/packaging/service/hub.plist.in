<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DSPi Link hub as a launchd agent: shares this Mac's DSPi devices on the network
  while you are logged in. A placeholder to adapt (WP TM11): see README.md. A template:
  render.sh fills in the command name (WP CLEAN1).

  Install:
    cp se.bofr.@CMD@.hub.plist ~/Library/LaunchAgents/
    (edit the @CMD@ path, and USERNAME in the log paths)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/se.bofr.@CMD@.hub.plist
  Remove:
    launchctl bootout gui/$(id -u)/se.bofr.@CMD@.hub

  PIN pairing is the default: do not add the open option here. To pair a client,
  bootout the agent, run `@CMD@ hub` in Terminal, type `pair`, and bootstrap it
  again when the client has paired. `@CMD@ hub` keeps the Mac awake while it runs
  (caffeinate); to let it sleep, add the no-keep-awake option (README.md).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>se.bofr.@CMD@.hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/@CMD@</string>
        <string>hub</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Not restarted. launchd cannot tell a crash from a refused start (exit 1:
         another hub holds the store, or a change of access mode; exit 4: the port in
         use), which would be retried every few seconds for ever. Read the log, then
         bootstrap it again. -->
    <!-- launchd sends SIGTERM; the hub stops cleanly within this. -->
    <key>ExitTimeOut</key>
    <integer>20</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>warn</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/@CMD@-hub.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/@CMD@-hub.log</string>
</dict>
</plist>
