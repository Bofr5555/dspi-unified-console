+
+    private fun theme(content: @Composable () -> Unit) = rule.setContent {
+        view = LocalView.current
+        MaterialTheme(colorScheme = darkColorScheme()) { Surface(Modifier.fillMaxSize()) { content() } }
+    }
+
+    private fun shot(name: String) {
+        if (OUT.isEmpty()) return
+        rule.runOnUiThread {
+            val root = view.rootView
+            val bmp = Bitmap.createBitmap(root.width, root.height, Bitmap.Config.ARGB_8888)
+            root.draw(Canvas(bmp))
+            FileOutputStream(File(OUT, "$name.png")).use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        }
+    }
+
+    /** The bridge posts to the main looper, which nothing else pumps here; the FFI thread runs in real time. */
+    private fun pump(what: String, until: () -> Boolean) {
+        val end = System.currentTimeMillis() + 15_000
+        while (!until()) {
+            check(System.currentTimeMillis() < end) { "timed out: $what" }
+            shadowOf(android.os.Looper.getMainLooper()).idle()
+            Thread.sleep(10)
+        }
+    }
+
+    private fun settle() {
+        repeat(30) {
+            shadowOf(android.os.Looper.getMainLooper()).idle()
+            rule.mainClock.advanceTimeBy(100)
+            Thread.sleep(5)
+        }
+    }
+
+    private fun waitConnected() {
+        bridge
+        pump("connected") { bridge.status.value.connected }
+    }
+
+    private fun waitLoaded() {
+        waitConnected()
+        rule.mainClock.autoAdvance = false
+        pump("loaded") { bridge.cs.loaded.value }
+    }
+
