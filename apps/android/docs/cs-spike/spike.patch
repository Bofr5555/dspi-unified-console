+/** A measured scroller: reports its content's height in dp. */
+@Composable
+private fun MeasuredColumn(onHeight: (Float) -> Unit, content: @Composable () -> Unit) {
+    val d = LocalDensity.current
+    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState())) {
+        Column(Modifier.fillMaxWidth().onSizeChanged { onHeight(with(d) { it.height.toDp().value }) }) { content() }
+    }
+}
