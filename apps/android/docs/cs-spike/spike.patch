+// ── A spike's model: the snapshot as is, and the few rules a row list needs ──
+
+private const val BUTTON = 1
+private const val SWITCH = 2
+private const val POT = 3
+private const val ENCODER = 4
+private const val LED = 5
+private const val LED_PWM = 6
+private const val IR = 7
+private const val DISPLAY = 8
+private const val AUX_OUT = 9
+private const val AUX_PWM = 10
+private val TYPE_NAMES = listOf(
+    "None", "Push Button", "Toggle Switch", "Potentiometer / Fader", "Rotary Encoder", "Indicator LED", "Dimmable LED", "IR Remote",
+    "Display", "On/Off Output", "Dimmable Output"
+)
+private const val KIND_BOOL = 1
+private const val KIND_ENUM = 2
+
+private class Snap(json: String) {
+    val o = JSONObject(json)
+    val supported = o.optBoolean("supported")
+    val types: JSONArray get() = o.getJSONArray("types")
+    val nouns: JSONArray get() = o.getJSONArray("nouns")
+    val bindings: JSONArray get() = o.getJSONArray("bindings")
+    val names: JSONArray get() = o.getJSONArray("names")
+
+    fun validNouns(t: Int): List<Int> =
+        (0 until nouns.length()).filter { nouns.getJSONObject(it).getInt("actions") and types.getJSONObject(t).getInt("actions") != 0 }
+
+    fun validActions(t: Int, n: Int): List<Int> {
+        val eff = types.getJSONObject(t).getInt("actions") and nouns.getJSONObject(n).getInt("actions")
+        return (0 until 16).filter { eff shr it and 1 == 1 }
+    }
+}
+
+/** One row a binding's editor shows, as `CsRecordEditor.qml` and Swift's `slotSection` decide it. */
+private data class R(val title: String, val detail: String, val value: String = "", val toggle: Boolean = false)
+
+private fun rowsFor(s: Snap, t: Int, n: Int, action: Int): List<R> {
+    val nd = s.nouns.getJSONObject(n)
+    val kind = nd.getInt("kind")
+    val out = ArrayList<R>()
+    out += R("Name", "A label for this control.", "Volume Knob")
+    out += R("Controls", "The device function this control drives.", "Filter Frequency")
+    if (nd.getInt("targetKind") != 0) out += R("Channel or Group", "Which channel, or named set of channels, this control affects.", "Output 1")
+    if (nd.getInt("targetKind") == 3) out += R("Band", "Which filter band this control affects.", "Band 1")
+    if (s.validActions(t, n).size > 1) out += R("Behavior", "How this control drives the function.", "Increase")
+    if (t == BUTTON) out += R("Gesture", "Which press gesture triggers this. Bind several to one button GPIO for multiple functions.", "Press")
+    out += R(if (t == ENCODER) "GPIO A" else "GPIO", "Wire between this GPIO and GND.", "GPIO 10")
+    if (t == ENCODER) out += R("GPIO B", "Wire between this GPIO and GND.", "GPIO 11")
+    if (kind == 0) {
+        if (action == 5) out += R("Set To", "The value a press sets.", "0.0 dB")
+        out += R("Step Size", "How far each detent moves.", "1.0 dB")
+        if (t == POT || t == LED_PWM) {
+            out += R("Limit Range", "Confine the knob to part of the range.", toggle = true)
+            out += R("Minimum", "The low end.", "-60.0 dB")
+            out += R("Maximum", "The high end.", "0.0 dB")
+        }
+    } else {
+        if (action == 5) out += R("Set To", "The value a press sets.", "On")
+        if (kind == KIND_ENUM) out += R("Step Size", "How many positions each press moves.", "1")
+        if (kind == KIND_ENUM) out += R("Wrap Around", "Step past the last position back to the first.", toggle = true)
+    }
+    if (t == LED || t == LED_PWM) {
+        out += R("Turn-On Delay", "Wait before the LED lights.", "0 s")
+        out += R("Turn-Off Delay", "Hold the LED after the condition ends.", "0 s")
+    }
+    if (t == LED_PWM) out += R("Brightness Limit", "Ceiling for this LED.", "100 %")
+    if (t == POT || t == ENCODER) out += R("Reverse Direction", "Clockwise decreases the value.", toggle = true)
+    if (t == ENCODER) out += R("Acceleration", "Fast spins move in larger steps; slow spins stay fine.", toggle = true)
+    if (t == BUTTON) out += R("Repeat While Held", "After holding ~0.4 s the press repeats automatically.", toggle = true)
+    out += R("Active-Low", "The wiring pulls this pin low when active.", toggle = true)
+    return out
+}
+
