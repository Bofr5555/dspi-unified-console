+        val s = Snap(json)
+        val t3 = System.nanoTime()
+        say("snapshot bytes=${json.length} fetchMs=${(t1 - t0) / 1_000_000} snapshotMs=${(t2 - t1) / 1_000_000} parseMs=${(t3 - t2) / 1_000_000}")
+        val avail = (0 until s.nouns.length()).count { s.nouns.getJSONObject(it).getInt("actions") != 0 }
+        say("nouns described=${s.nouns.length()} available=$avail types=${s.types.length()} caps=${s.o.getInt("capsVersion")}")
+        for (t in 1..10) {
+            val v = s.validNouns(t)
+            val acts = v.map { s.validActions(t, it).size }
+            say("type ${TYPE_NAMES[t]}: validNouns=${v.size} maxActions=${acts.maxOrNull() ?: 0}")
+        }
+        val b = s.bindings
+        for (i in 0 until b.length()) if (b.getJSONObject(i).getInt("type") != 0) say("slot $i '${s.names.optString(i)}' ${b.getJSONObject(i)}")
+        val gs = s.o.getJSONArray("groups")
+        (0 until gs.length()).filter { gs.getJSONObject(it).getLong("memberMask") != 0L }.forEach { say("group $it ${gs.getJSONObject(it)}") }
+        val ms = s.o.getJSONArray("macros")
+        (0 until ms.length()).filter { ms.getJSONObject(it).getJSONArray("steps").length() > 0 }.forEach { say("macro $it ${ms.getJSONObject(it)}") }
+        say("ir configured=" + (0 until s.o.getJSONArray("ir").length()).count { s.o.getJSONArray("ir").getJSONObject(it).getInt("protocol") != 0 })
+        say("display=" + s.o.getJSONObject("display").getJSONObject("config"))
+        // A refused op, in the reply shape AN9 has to show
+        say("clash " + real.csApply("""{"op":"binding","index":5,"binding":{"type":1,"noun":2,"action":4,"gpio0":16,"gpio1":255,"value":1}}"""))
