+@Composable
+private fun Row1(r: R, onClick: (() -> Unit)? = null) {
+    Row(
+        Modifier.fillMaxWidth().then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier).padding(horizontal = 16.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Column(Modifier.weight(1f)) {
+            Text(r.title, style = MaterialTheme.typography.bodyLarge)
+            Text(r.detail, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        Spacer(Modifier.width(12.dp))
+        if (r.toggle) Switch(false, {}) else if (r.value.isNotEmpty()) Text(r.value, color = MaterialTheme.colorScheme.primary)
+    }
+}
+
+@Composable
+private fun Rows(rows: List<R>, click: (R) -> Unit = {}) {
+    Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer), modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        Column(Modifier.padding(vertical = 4.dp)) {
+            rows.forEachIndexed { i, r ->
+                if (i > 0) HorizontalDivider(Modifier.padding(start = 16.dp))
+                Row1(r) { click(r) }
+            }
+        }
+    }
+}
