+// ── The prototype itself: list, editor page, picker page ──
+
+private sealed interface Screen {
+    data object List : Screen
+
+    data class Edit(val slot: Int) : Screen
+
+    data class Pick(val slot: Int) : Screen
+}
+
+@Composable
+private fun CsPhone(bridge: DspiBridge) {
+    val json by bridge.cs.model.collectAsState()
+    var screen by remember { mutableStateOf<Screen>(Screen.List) }
+    val scope = rememberCoroutineScope()
+    var draft by remember { mutableStateOf<JSONObject?>(null) }
+    var error by remember { mutableStateOf<String?>(null) }
+    if (json.isEmpty()) {
+        Text("Reading...")
+        return
+    }
+    val s = Snap(json)
+    if (!s.supported) {
+        Text("No control surfaces")
+        return
+    }
+    when (val sc = screen) {
+        Screen.List -> LazyColumn(Modifier.fillMaxSize().testTag("list")) {
+            (0 until s.bindings.length()).filter { s.bindings.getJSONObject(it).getInt("type") != 0 }.forEach { slot ->
+                val b = s.bindings.getJSONObject(slot)
+                item {
+                    Row1(R(s.names.optString(slot).ifEmpty { TYPE_NAMES[b.getInt("type")] }, "${TYPE_NAMES[b.getInt("type")]} · GPIO ${b.getInt("gpio0")}", "Active")) {
+                        draft = JSONObject(b.toString())
+                        error = null
+                        screen = Screen.Edit(slot)
+                    }
+                }
+            }
+            item {
+                TextButton(onClick = {
+                    val free = (0 until s.bindings.length()).first { s.bindings.getJSONObject(it).getInt("type") == 0 }
+                    draft = JSONObject(mapOf("type" to BUTTON, "noun" to 2, "action" to 4, "gpio0" to 5, "gpio1" to 255, "value" to 1))
+                    error = null
+                    screen = Screen.Edit(free)
+                }) { Text("Add a control") }
+            }
+        }
+        is Screen.Edit -> Column(Modifier.fillMaxSize().testTag("editor")) {
+            val b = draft!!
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                TextButton(onClick = { screen = Screen.List }) { Text("‹ Controls") }
+                Text("Slot ${sc.slot + 1}")
+            }
+            Column(Modifier.weight(1f).verticalScroll(rememberScrollState())) {
+                error?.let { Text(it, color = Color(0xFFFF453A), modifier = Modifier.padding(16.dp).testTag("error")) }
+                Row1(R("Controls", "The device function this control drives.", "noun ${b.getInt("noun")}")) { screen = Screen.Pick(sc.slot) }
+                Row1(R("GPIO", "Wire between this GPIO and GND.", "GPIO ${b.getInt("gpio0")}")) {
+                    b.put("gpio0", 16) // the spike's "pick a pin": a pin the demo's button already holds
+                    draft = JSONObject(b.toString())
+                }
+            }
+            Row(Modifier.fillMaxWidth().padding(8.dp), horizontalArrangement = Arrangement.End) {
+                Button(onClick = {
+                    scope.launch {
+                        val r = JSONObject(bridge.cs.apply(JSONObject(mapOf("op" to "binding", "index" to sc.slot, "binding" to b)).toString()))
+                        if (r.optBoolean("ok")) screen = Screen.List else error = r.optString("error").ifEmpty { bridge.cs.statusMessage(r.optInt("status", 255)) }
+                    }
+                }) { Text("Apply") }
+            }
+        }
+        is Screen.Pick -> LazyColumn(Modifier.fillMaxSize().testTag("picker")) {
+            val b = draft!!
+            s.validNouns(b.getInt("type")).forEach { n ->
+                item {
+                    Row1(R("Noun $n", s.validActions(b.getInt("type"), n).size.toString() + " actions")) {
+                        b.put("noun", n)
+                        b.put("action", s.validActions(b.getInt("type"), n).first())
+                        draft = JSONObject(b.toString())
+                        screen = Screen.Edit(sc.slot)
+                    }
+                }
+            }
+        }
+    }
+}
