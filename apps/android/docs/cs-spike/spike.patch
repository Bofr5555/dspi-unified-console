+    /** Heights of the desktop's rows laid out at this width, for the screen map. */
+    private fun measure(name: String, content: @Composable () -> Unit): Float {
+        var h = 0f
+        rule.mainClock.autoAdvance = false
+        theme { MeasuredColumn({ h = it }) { content() } }
+        settle()
+        return h.also { say("height $name = ${"%.0f".format(it)} dp") }
+    }
