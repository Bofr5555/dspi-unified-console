+    @After
+    fun stop() {
+        rule.runOnUiThread { if (bridgeMade) runCatching { bridge.close() } }
+        scope.cancel()
+        ffi.close()
+        shadowOf(android.os.Looper.getMainLooper()).idle()
+        runCatching { real.close() }
