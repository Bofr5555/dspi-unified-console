# Debian 13 (trixie) with its own Qt 6.8 packages: the build the .deb is made
# from, against the distribution's Qt (glibc 2.41).
#
#   podman build -t dspi-uconsole-debian -f apps/desktop/packaging/linux/Containerfile.debian apps/desktop/packaging/linux
#   podman run --rm -v "$PWD":/src:Z -w /src dspi-uconsole-debian apps/desktop/packaging/linux/build-debian.sh
FROM docker.io/library/debian:trixie

ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUST_TOOLCHAIN=1.99.1

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl cmake ninja-build g++ pkg-config file binutils libasound2-dev \
      qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-svg-dev qt6-tools-dev qt6-tools-dev-tools \
 && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN d=$(mktemp -d) \
 && curl --proto '=https' --tlsv1.2 -fsSL -o "$d/rustup-init" \
      "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "$RUSTUP_INIT_SHA256  $d/rustup-init" | sha256sum -c - \
 && chmod +x "$d/rustup-init" \
 && "$d/rustup-init" -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
 && rm -rf "$d"
