# Build environment for the Windows release, cross-compiled on Linux:
#   podman build -t dspi-windows packaging/windows
#   podman run --rm -v "$PWD":/src:Z -w /src dspi-windows packaging/windows/build-windows.sh
# Everything from Fedora's repositories, Rust from rustup.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
      gcc cmake ninja-build python3 curl ca-certificates \
      mingw64-gcc-c++ mingw64-binutils \
      mingw64-qt6-qtbase mingw64-qt6-qtdeclarative mingw64-qt6-qtsvg mingw64-qt6-qttools \
      qt6-qtdeclarative-devel mingw32-nsis \
 && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
 && rustup target add x86_64-pc-windows-gnu && chmod -R a+rwX /opt/cargo /opt/rustup
