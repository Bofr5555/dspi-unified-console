# Build environment for the Windows release, cross-compiled on Linux:
#   podman build -t dspi-windows apps/desktop/packaging/windows
#   podman run --rm -v "$PWD":/src:Z -w /src dspi-windows apps/desktop/packaging/windows/build-windows.sh
# (from the dspi-unified-console root)
# Everything from Fedora's repositories, Rust from rustup.
# -- WP QP20 -- MINGW_QT_VERSION is the MinGW Qt this image must have: the
# bundle's notice names it and takes Qt's licence texts from
# packaging/licences/qt-<version>/ (licences/qt-modules.sh windows). When
# Fedora moves on, the build stops here; update it, then run
# release-sources.sh and licences/update-licences.sh.
FROM registry.fedoraproject.org/fedora:44
ARG MINGW_QT_VERSION=6.11.2
RUN dnf -y install --setopt=install_weak_deps=False \
      gcc cmake ninja-build python3 curl ca-certificates \
      mingw64-gcc-c++ mingw64-binutils \
      mingw64-qt6-qtbase mingw64-qt6-qtdeclarative mingw64-qt6-qtsvg mingw64-qt6-qttools \
      qt6-qtdeclarative-devel mingw32-nsis \
 && dnf clean all \
 && v=$(rpm -q --qf '%{VERSION}' mingw64-qt6-qtbase) \
 && { [ "$v" = "$MINGW_QT_VERSION" ] || { echo "MinGW Qt is $v, MINGW_QT_VERSION says $MINGW_QT_VERSION" >&2; exit 1; }; }
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
 && rustup target add x86_64-pc-windows-gnu && chmod -R a+rwX /opt/cargo /opt/rustup
