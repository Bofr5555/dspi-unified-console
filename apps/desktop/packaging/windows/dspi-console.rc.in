// Windows resources: the exe's icon and its version information (Explorer's
// Properties > Details). -- WP QP20 -- Configured by qt/cmake/wp/qp20.cmake.
#include <winver.h>

IDI_ICON1 ICON "@DSPI_WIN_DIR@/dspi-console.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @DSPI_VER_MAJOR@,@DSPI_VER_MINOR@,@DSPI_VER_PATCH@,0
PRODUCTVERSION @DSPI_VER_MAJOR@,@DSPI_VER_MINOR@,@DSPI_VER_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DSPi unified console maintainers\0"
            VALUE "FileDescription", "@DSPI_DISPLAY_NAME@\0"
            VALUE "FileVersion", "@DSPI_VERSION@\0"
            VALUE "InternalName", "DSPiConsole\0"
            VALUE "OriginalFilename", "DSPiConsole.exe\0"
            VALUE "ProductName", "@DSPI_DISPLAY_NAME@\0"
            VALUE "ProductVersion", "@DSPI_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
