# Maintainer: WeebLabs <https://github.com/WeebLabs>
# Builds DSPi Console from source against the system Qt 6, from the
# dspi-unified-console repository (the app is apps/desktop, its core crates/).
pkgname=dspi-console
pkgver=1.1.6
pkgrel=1
_commit=c4b71f136d79b7d434674696cfdcfb0924cb0f99
pkgdesc="Control application for the DSPi audio processor"
arch=('x86_64')
url="https://github.com/Bofr5555/dspi-unified-console"
license=('unknown')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'kwindowsystem' 'hicolor-icon-theme'
         'alsa-lib' 'libx11' 'libglvnd' 'libstdc++' 'libgcc' 'glibc')
makedepends=('git' 'cargo' 'cmake' 'ninja')
optdepends=('xdg-desktop-portal: native file dialogs'
            'udisks2: firmware updates')
install=dspi-console.install
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release -p dspi-capi --features link,midir,mdns,hub
    # -- WP QD16 -- pacman updates the app: no check for releases of our own
    cmake -S apps/desktop/qt -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr \
          -DDSPI_QT_MAJOR=6 -DDSPI_CARGO_TARGET_DIR="$PWD/target" -DDSPI_UPDATE_CHECK=OFF
    cmake --build build
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build
}
