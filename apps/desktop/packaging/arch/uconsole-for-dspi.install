# pacman install hooks (PKGBUILD(5), "install"): the package ships a udev rule
# for the DSPi's USB interface; reload the rules so a DSPi plugged in now is
# usable without a reboot.
post_install() {
    udevadm control --reload-rules
    udevadm trigger --subsystem-match=usb --action=change
}

post_upgrade() {
    post_install
}

post_remove() {
    udevadm control --reload-rules
}
