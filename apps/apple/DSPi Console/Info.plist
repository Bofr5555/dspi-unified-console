<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DSPiFirmwareVersion</key>
	<string>$(DSPI_FIRMWARE_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>uConsole for DSPi needs access to removable volumes to install firmware onto a board in bootloader mode.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>uConsole for DSPi shares your connected DSPi devices with apps and browsers on your local network, and discovers devices shared by other machines.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dspi._tcp</string>
	</array>
	<!-- WP SECSW: dspi://pair links (the hub's QR code), parsed by the core
	     and confirmed by the person before anything is dialled. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>DSPi Link pairing link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dspi</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
</dict>
</plist>
